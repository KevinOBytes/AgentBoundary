message: "If you use AgentBoundary, cite this repository and the exact commit or archived version used for the results."
title: "AgentBoundary: Empirical Instruction-Boundary Evaluation"
authors:
  - family-names: "O'Connor"
    given-names: "Kevin"
    affiliation: "TKOResearch LLC"
repository-code: "https://github.com/KevinOBytes/AgentBoundary"
