{
  "result_manifest_version": "1.0.0",
  "default_outputs": {
    "json": "results/model_results.json",
    "csv": "results/model_results.csv"
  },
  "benchmark_visualizations": {
    "summary": "results/benchmark_current_summary.json",
    "coverage": "results/benchmark_current_coverage.svg",
    "failure_modes": "results/benchmark_current_failure_modes.svg",
    "model_risk": "results/benchmark_current_model_risk.svg",
    "attack_family_risk": "results/benchmark_current_attack_family_risk.svg"
  },
  "required_top_level_keys": [
    "metadata",
    "metrics",
    "metrics_by_model",
    "results"
  ],
  "retention_policy": {
    "artifact_store": "Cloudflare R2 or GitHub Releases",
    "recommended_retention_days": 365,
    "checksum": "sha256"
  }
}
